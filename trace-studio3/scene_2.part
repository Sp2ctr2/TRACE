private fun vectorPath(n:JSONObject,width:Float,height:Float):Path {
    val p=n.optJSONObject("props")?:JSONObject();val type=n.optString("type");val path=Path();fun px(v:Float)=v/100f*width;fun py(v:Float)=v/100f*height
    when(type){
        "ellipse"->path.addOval(Rect(0f,0f,width,height))
        "line","path"->{val anchors=p.optJSONArray("anchors")?.nodes()?:listOf(JSONObject().put("x",0).put("y",if(type=="line")50 else 75).put("outX",30).put("outY",0),JSONObject().put("x",100).put("y",if(type=="line")50 else 25).put("inX",65).put("inY",100));if(anchors.isNotEmpty()){val first=anchors.first();path.moveTo(px(first.f("x")),py(first.f("y")));for(i in 1 until anchors.size){val a=anchors[i-1];val b=anchors[i];path.cubicTo(px(a.f("outX",a.f("x"))),py(a.f("outY",a.f("y"))),px(b.f("inX",b.f("x"))),py(b.f("inY",b.f("y"))),px(b.f("x")),py(b.f("y")))};if(p.optBoolean("closed")){val a=anchors.last();val b=anchors.first();path.cubicTo(px(a.f("outX",a.f("x"))),py(a.f("outY",a.f("y"))),px(b.f("inX",b.f("x"))),py(b.f("inY",b.f("y"))),px(b.f("x")),py(b.f("y")));path.close()}}}
        "star","polygon"->{val count=p.optInt("points",5).coerceIn(3,16)*(if(type=="star")2 else 1);for(i in 0 until count){val angle=(i.toFloat()/count*2-.5)*Math.PI;val radius=if(type=="star"&&i%2==1)p.f("innerRadius",.46f,.1f,.9f) else 1f;val x=width/2+cos(angle).toFloat()*width/2*radius;val y=height/2+sin(angle).toFloat()*height/2*radius;if(i==0)path.moveTo(x,y)else path.lineTo(x,y)};path.close()}
        "boolean"->{val children=n.optJSONArray("children")?.nodes().orEmpty();var combined:Path?=null;for(c in children){val cp=c.optJSONObject("props")?:JSONObject();val child=vectorPath(c,cp.f("width",100f)/p.f("width",180f).coerceAtLeast(1f)*width,cp.f("height",100f)/p.f("height",120f).coerceAtLeast(1f)*height);child.translate(Offset(cp.f("x")/p.f("width",180f).coerceAtLeast(1f)*width,cp.f("y")/p.f("height",120f).coerceAtLeast(1f)*height));combined=if(combined==null)child else Path.combine(when(p.optString("operation")){"subtract"->PathOperation.Difference;"intersect"->PathOperation.Intersect;"xor"->PathOperation.Xor;else->PathOperation.Union},combined,child)};return combined?:path}
        else->{val corners=p.optJSONArray("corners");val radius=p.f("radius",0f,0f,500f);fun corner(i:Int)=CornerRadius(((corners?.optDouble(i,radius.toDouble())?.toFloat()?:radius)*width/p.f("width",180f).coerceAtLeast(1f)).coerceIn(0f,min(width,height)/2));path.addRoundRect(RoundRect(0f,0f,width,height,corner(0),corner(1),corner(2),corner(3)))}
    };return path
}
@Composable private fun SceneVector(n:JSONObject){val p=n.optJSONObject("props")?:JSONObject();Canvas(Modifier.fillMaxWidth().height(p.f("height",120f,4f,3000f).dp)){
    val path=vectorPath(n,size.width,size.height);val fill=p.optString("fill","#EDE8DD");if(fill !in listOf("none","transparent")){val color=SceneDocument.colorValue(fill,"#EDE8DD");if(p.optString("fillType")=="linear"){val angle=p.f("gradientAngle",90f)*Math.PI/180;drawPath(path,Brush.linearGradient(listOf(color,SceneDocument.colorValue(p.optString("fill2"),"#D93B25")),start=Offset.Zero,end=Offset(size.width*(.5f+cos(angle).toFloat()*.5f),size.height*(.5f+sin(angle).toFloat()*.5f))))}else drawPath(path,color)}
    if(p.optString("stroke","none") !in listOf("none","transparent")){val width=p.f("strokeWidth",1f,0f,24f).dp.toPx();if(width>0)drawPath(path,SceneDocument.colorValue(p.optString("stroke"),"#20211F"),style=Stroke(width=width,cap=StrokeCap.Round,pathEffect=when(p.optString("dash")){"dashed"->PathEffect.dashPathEffect(floatArrayOf(8.dp.toPx(),5.dp.toPx()));"dotted"->PathEffect.dashPathEffect(floatArrayOf(1.dp.toPx(),4.dp.toPx()));else->null}))}
}}
@Composable private fun SceneImage(n:JSONObject){val p=n.optJSONObject("props")?:JSONObject();val raw=p.optString("image");val bitmap=remember(raw){runCatching{if(!raw.matches(Regex("data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+")))null else {val bytes=Base64.decode(raw.substringAfter(','),Base64.DEFAULT);val opt=BitmapFactory.Options().apply{inJustDecodeBounds=true};BitmapFactory.decodeByteArray(bytes,0,bytes.size,opt);if(opt.outWidth.toLong()*opt.outHeight>6_000_000 || opt.outWidth<=0 || opt.outHeight<=0)null else BitmapFactory.decodeByteArray(bytes,0,bytes.size)?.asImageBitmap()}}.getOrNull()};if(bitmap!=null)Image(bitmap,p.optString("alt","이미지"),Modifier.fillMaxWidth().height(p.f("height",120f,4f,3000f).dp),contentScale=when(p.optString("fit")){"contain"->ContentScale.Fit;"fill"->ContentScale.FillBounds;else->ContentScale.Crop},alignment=androidx.compose.ui.BiasAlignment(p.f("imageX",50f,0f,100f)/50f-1,p.f("imageY",50f,0f,100f)/50f-1))else Box(Modifier.fillMaxWidth().height(80.dp).background(Color(0xFFEDEFE8))) }
