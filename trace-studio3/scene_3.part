@Composable private fun SceneBankBlock(n:JSONObject,v:SceneData,screen:String,action:(String)->Unit){
    val d=LocalDocument.current;val senior=LocalSceneSenior.current;val p=n.optJSONObject("props")?:JSONObject();val type=n.optString("type");val text=n.optString("text");val body=if(senior)20 else p.optInt("fontSize",d.token("bodySize",16)).coerceIn(12,46);val muted=d.color("muted","#696B64");val primary=d.color("primary","#D93B25");val border=d.color("border","#E2E1DA");val ink=d.color("ink","#20211F")
    @Composable fun Small(t:String){Text(t,color=muted,fontSize=if(senior)16.sp else 12.sp,lineHeight=if(senior)25.sp else 19.sp)}
    @Composable fun Money(a:Long){BoxWithConstraints(Modifier.fillMaxWidth()){val density=LocalDensity.current;val size=minOf(d.token("amountSize",38,28,46).toFloat(),(maxWidth.value-22f)/(money(a).length*.57f*density.fontScale)).coerceAtLeast(18f);Text(money(a),fontSize=size.sp,lineHeight=(size*1.3).sp,fontWeight=FontWeight.Bold,maxLines=1)}}
    @Composable fun Item(title:String,subtitle:String="",value:String="",dest:String=""){Column(Modifier.fillMaxWidth().heightIn(min=if(senior)84.dp else 68.dp).then(if(dest.isNotBlank())Modifier.clickable(role=Role.Button){action(dest)}else Modifier).padding(vertical=12.dp)){if(senior){Text(title,fontSize=body.sp,fontWeight=FontWeight.Medium);if(value.isNotBlank())Text(value,fontSize=body.sp,fontWeight=FontWeight.SemiBold)}else Row(verticalAlignment=Alignment.CenterVertically){Text(title,Modifier.weight(1f),fontSize=body.sp,fontWeight=FontWeight.Medium);if(value.isNotBlank())Text(value,fontSize=body.sp,fontWeight=FontWeight.SemiBold)};if(subtitle.isNotBlank())Small(subtitle)}}
    @Composable fun Detail(a:String,b:String){if(senior)Column(Modifier.padding(vertical=10.dp)){Small(a);Text(b,fontSize=body.sp)}else Row(Modifier.fillMaxWidth().padding(vertical=12.dp),horizontalArrangement=Arrangement.spacedBy(16.dp)){Text(a,Modifier.weight(.8f),color=muted,fontSize=13.sp);Text(b,Modifier.weight(1.3f),fontSize=14.sp,textAlign=TextAlign.End)}}
    @Composable fun Boxed(content:@Composable ColumnScope.()->Unit){Column(Modifier.fillMaxWidth().background(d.color("surface","#FFFFFF"),RoundedCornerShape(d.token("radius",14,0,32).dp)).border(1.dp,border,RoundedCornerShape(d.token("radius",14,0,32).dp)).padding(18.dp),content=content)}
    @Composable fun Brand(){val logo=d.brand.optString("logo");Row(verticalAlignment=Alignment.CenterVertically,horizontalArrangement=Arrangement.spacedBy(8.dp)){if(logo.startsWith("data:image/")){Box(Modifier.width(d.brand.optInt("logoWidth",26).coerceIn(16,160).dp)){SceneImage(JSONObject().put("props",JSONObject().put("image",logo).put("height",d.brand.optInt("logoHeight",26)).put("fit","contain").put("alt",d.name))}}else Canvas(Modifier.size(26.dp)){val u=size.width/24;drawRect(primary,Offset(3*u,3*u),Size(18*u,5*u));drawRect(primary,Offset(10*u,10*u),Size(5*u,11*u));drawRect(primary,Offset(3*u,10*u),Size(5*u,6*u))};if(d.brand.optBoolean("showName",true))Text(d.name,fontSize=23.sp,fontWeight=FontWeight.Bold)}}
    when(type){
        "brand"->Brand()
        "heading"->Text(if(senior&&screen=="hold")"송금을 잠시\n멈췄습니다." else if(p.optString("bind")=="recipient")v.recipient+"님에게" else text,Modifier.fillMaxWidth().semantics{heading()},fontSize=(if(senior)31 else p.optInt("fontSize",d.token("titleSize",28,20,38))).sp,lineHeight=(if(senior)42f else p.optInt("fontSize",d.token("titleSize",28))*1.34f).sp,fontWeight=FontWeight(p.optInt("weight",700).coerceIn(100,900)))
        "text","notice"->Text(text,fontSize=if(type=="notice")if(senior)16.sp else 13.sp else body.sp,color=if(type=="notice")muted else LocalTextStyle.current.color,lineHeight=(body*1.6).sp)
        "balance"->{Item(if(p.optString("mode")=="total")"총 보유 자산" else d.brand.optString("account",d.name+" 생활통장"),dest="account");Money(v.balance+if(p.optString("mode")=="total")2_400_000 else 0);Spacer(Modifier.height(8.dp));Small(d.name+" 110-***-0001")}
        "quick"->{if(senior)Column{Button(onClick={action("recipient")},Modifier.fillMaxWidth().heightIn(min=64.dp),colors=ButtonDefaults.buttonColors(containerColor=primary)){Text("송금하기",fontSize=20.sp)};TextButton(onClick={action("history")},Modifier.fillMaxWidth().heightIn(min=60.dp)){Text("거래 내역 보기",fontSize=20.sp,color=ink)}}else Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween){listOf("송금" to "recipient","가져오기" to "bring","내역" to "history").forEach{(label,dest)->TextButton(onClick={action(dest)},Modifier.heightIn(min=52.dp)){Text(label,color=if(dest=="recipient")primary else ink)}}}}
        "history"->{Item(text.ifBlank{"최근 거래"},dest="history");v.items.take(if(screen=="home")3 else 40).forEach{Item(it.title,it.subtitle,it.value,it.action)}}
        "safety"->{HorizontalDivider(color=border);Item(if(v.pending)"확인이 필요한 송금 1건" else "Trace 안전 확인",if(v.pending)"아직 돈은 나가지 않았습니다." else "최근 연결된 위험 정황 없음",dest="safety")}
        "transaction"->{if(p.optBoolean("compact"))Money(v.amount)else Boxed{Small(if(v.official)"확인된 상환처" else "현재 송금 계좌");Spacer(Modifier.height(10.dp));Money(v.amount);Spacer(Modifier.height(10.dp));Small(v.bank+" · "+v.recipient)}}
        "reassurance"->{Text("아직 돈은 나가지 않았습니다.",fontSize=body.sp);if(screen=="hold"){Spacer(Modifier.height(5.dp));Small("방금 전의 요청이 이 송금과 이어져 있어요.")}}
        "reasons"->v.reasons.forEachIndexed{i,r->Row(Modifier.fillMaxWidth().heightIn(min=if(senior)64.dp else 48.dp).clickable(role=Role.Button){action("reason:$i")}.padding(vertical=10.dp),horizontalArrangement=Arrangement.spacedBy(12.dp),verticalAlignment=Alignment.CenterVertically){Small("0${i+1}");Text(r,Modifier.weight(1f),fontSize=body.sp);Text("✓",color=primary)}}
        "review"->{Detail("받는 계좌",v.bank+"\n"+v.account);Detail("출금 계좌",d.brand.optString("account",d.name+" 생활통장"));Detail("수수료","0원");Detail("송금 목적",v.purpose)}
        "assets"->{Item(d.name+" 생활통장","입출금",money(v.balance),"account");Item(d.name+" 모아적금","적금","2,400,000원","savings");Item(d.name+" 체크카드","이번 달 이용","382,400원","card");Item("생활안심대출","남은 원금",money(v.loan),"loan")}
        "recipients"->{var query by remember{mutableStateOf("")};OutlinedTextField(query,{query=it},Modifier.fillMaxWidth(),label={Text("이름·은행·계좌 검색")},singleLine=true);Item("계좌번호로 보내기",dest="newRecipient");v.items.filter{it.title.contains(query)||it.subtitle.contains(query)}.forEach{Item(it.title,it.subtitle,it.value,it.action)}}
        "amount"->{Small(v.recipient+" · "+v.bank);Spacer(Modifier.height(18.dp));Money(v.amount);Small("잔액 "+money(v.balance));Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween){listOf(10000,100000,1000000).forEach{TextButton(onClick={action("add:$it")}){Text("+${it/10000}만",color=ink)}}};listOf(listOf("1","2","3"),listOf("4","5","6"),listOf("7","8","9"),listOf("clear","0","delete")).forEach{row->Row(Modifier.fillMaxWidth()){row.forEach{key->TextButton(onClick={action("key:$key")},Modifier.weight(1f).heightIn(min=if(senior)66.dp else 56.dp)){Text(when(key){"clear"->"지우기";"delete"->"⌫";else->key},fontSize=if(key.length==1)27.sp else 16.sp,color=ink)}}}};Item("송금 목적",value=v.purpose,dest="purpose")}
        "route"->Boxed{Small("생활안심대출");Spacer(Modifier.height(12.dp));Text(d.name+" 대출상환센터",fontWeight=FontWeight.SemiBold);Small(d.name+" · 200-***-3014");Spacer(Modifier.height(18.dp));Money(v.amount)}
        "timeline"->listOf("09:41" to "기관 사칭 정황","09:42" to "의심 링크","09:45" to "긴급 송금 요구","09:47" to "새로운 수취인").forEach{(time,title)->Item(title,time)}
        "cases"->listOf("normal" to "정상 송금","hold" to "기관 사칭","loan" to "대출 상환","unknown" to "공식 경로 조회 실패","warn" to "확인 후 송금").forEach{(id,title)->Item(title,dest="case:$id")}
        "modes"->Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween){TextButton(onClick={action("senior:off")}){Text("기본",color=ink)};TextButton(onClick={action("senior:on")}){Text("노약자 모드",color=primary)}}
        "menu"->p.optJSONArray("items")?.let{arr->repeat(arr.length()){val a=arr.getJSONArray(it);Item(a.optString(0),dest=a.optString(1,"home"))}}
        "receipt"->{Text("✓",fontSize=40.sp,color=primary);Spacer(Modifier.height(24.dp));Money(v.amount);Text(v.recipient+"님에게 보냈어요.",fontSize=24.sp,fontWeight=FontWeight.SemiBold);Small("시연용 가상 거래 · 실제 자금 이동 없음")}
        "divider"->HorizontalDivider(color=border)
        "spacer"->Spacer(Modifier.height(p.f("height",24f,0f,200f).dp))
        "button"->Button(onClick={action(p.optString("action","home"))},Modifier.fillMaxWidth().heightIn(min=if(senior)64.dp else 56.dp),colors=ButtonDefaults.buttonColors(containerColor=primary),shape=RoundedCornerShape(d.token("buttonRadius",12,0,32).dp)){Text(text.ifBlank{"확인"})}
        "textpair"->{val pair=text.split('|',limit=2);Detail(pair.first(),pair.getOrElse(1){""})}
        else->Small("호스트에서 구현할 구성 요소: $type")
    }
}
